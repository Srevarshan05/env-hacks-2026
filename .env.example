PORT=5001
DATABASE_URL=postgresql://APP_USERNAME:APP_PASSWORD@YOUR_RDS_ENDPOINT:5432/env_db
# Download AWS RDS certificate bundle and specify file path:
DB_CA_PATH=./global-bundle.pem
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Public website URL used to generate node QR code destinations:
FRONTEND_URL=http://localhost:5173
# Allowed frontend origin(s), comma separated:
CORS_ORIGINS=http://localhost:5173
# Required when NODE_ENV=production, protect all device telemetry calls:
DEVICE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_DEVICE_SECRET
NODE_ENV=development
