# Python backend configuration. Copy to .env (git-ignored) and fill in. Never commit real values.

APP_ENV=development

# Either a full URL (URL-encode special characters in the password) ...
DATABASE_URL=postgresql://APP_USERNAME:APP_PASSWORD@hackathon-rdb.cpq0kqcegj1p.ap-south-1.rds.amazonaws.com:5432/ecoair
# ... or discrete values (easier with AWS Secrets Manager):
# DB_HOST=hackathon-rdb.cpq0kqcegj1p.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=ecoair
# DB_USER=APP_USERNAME
# DB_PASSWORD=APP_PASSWORD

# TLS with certificate + hostname verification. Download the CA bundle from
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSLMODE=verify-full
DB_CA_PATH=./global-bundle.pem

# Amazon Cognito user pool (Cognito > User pools > your pool). The frontend signs users in;
# the backend only verifies their ID tokens.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_IDS=YOUR_APP_CLIENT_ID
# Optional, for hosts without outbound internet: contents of {issuer}/.well-known/jwks.json
# COGNITO_JWKS_JSON={"keys":[...]}

# python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# simulator = demo flow sensor (points labelled [SIMULATED]); hardware = real device readings only
REFILL_VERIFICATION_MODE=simulator
POINTS_PER_LITER=10

# Simulator profile: 0.25 L/s for 5 s after a 2 s start delay = 1.25 L = 12 points
SIMULATOR_START_DELAY_S=2
SIMULATOR_TICK_S=1
SIMULATOR_FLOW_LPS=0.25
SIMULATOR_DURATION_S=5

CORS_ORIGINS=http://localhost:5173
# Base URL printed into QR stickers: {PUBLIC_APP_URL}/m/NODE-001
PUBLIC_APP_URL=http://localhost:5173
