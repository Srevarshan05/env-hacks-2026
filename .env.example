# Copy to .env.local. All VITE_ values are public browser configuration: no secrets here.
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:5001
# true once the backend serves GET /api/me (login then creates/loads the RDS user)
VITE_PROFILE_SYNC=false
# Read-only sensor API base URL (defaults to VITE_API_URL)
VITE_SENSOR_API_URL=https://xxxx.lambda-url.ap-south-1.on.aws
# false to read live sensor data instead of the simulated feed
VITE_USE_SAMPLE_DATA=true
